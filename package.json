{
  "name": "novel-relevancy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "build": "bun run --filter '*' build",
    "start": "bun run --parallel --filter '*' start",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --filter '@novel-relevancy/api' db:generate",
    "db:migrate": "bun run --filter '@novel-relevancy/api' db:migrate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
