{
  "name": "@novel-relevancy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "evaluate": "bun src/services/evaluate.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@novel-relevancy/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
