# HTTP server
PORT=3001
NODE_ENV=development

# Postgres connection string used by Drizzle (driver: Bun.sql).
# Leave empty until you have a database - `bun run run-local` will offer to
# start a local Postgres (via Docker) and save the URI here for you.
# Example local value: postgres://postgres:postgres@localhost:5432/novel_relevancy
PG_URI=

# Origin allowed to call this API directly ("*" allows any).
CORS_ORIGIN=*

# Gemini embeddings (required for seeding and scoring).
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_BATCH_SIZE=10
GEMINI_MAX_CONCURRENCY=3

# Scoring defaults (overridable per environment).
RELEVANCE_TOP_K=3
NOVELTY_TOP_K=5
RELEVANCE_THRESHOLD=0.72
NOVELTY_WEIGHTS=0.40,0.25,0.15,0.12,0.08

# Database pool sizing (kept small for PlanetScale connection limits).
PG_POOL_MAX=5
PG_POOL_IDLE_TIMEOUT=10
